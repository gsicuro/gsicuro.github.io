    <item>
      <title></title>
      <link>https://gsicuro.github.io/docs/teaching/fmath2/exams/exams/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://gsicuro.github.io/docs/teaching/fmath2/exams/exams/</guid>
      <description>&lt;!doctype html&gt;&#xA;&lt;html lang=&#34;it&#34;&gt;&#xA;&lt;head&gt;&#xA;  &lt;meta charset=&#34;utf-8&#34;&gt;&#xA;  &lt;meta name=&#34;viewport&#34; content=&#34;width=device-width, initial-scale=1&#34;&gt;&#xA;  &lt;title&gt;Risultati degli esami&lt;/title&gt;&#xA;  &lt;style&gt;&#xA;    :root {&#xA;      color-scheme: light;&#xA;      --ink: #172033;&#xA;      --muted: #667085;&#xA;      --grid: #dce3ec;&#xA;      --point: #2563eb;&#xA;      --point-active: #f97316;&#xA;      --surface: #ffffff;&#xA;    }&#xA;&#xA;    * { box-sizing: border-box; }&#xA;&#xA;    body {&#xA;      margin: 0;&#xA;      min-height: 100vh;&#xA;      display: grid;&#xA;      place-items: center;&#xA;      padding: 24px;&#xA;      color: var(--ink);&#xA;      background: #f5f7fb;&#xA;      font: 16px/1.45 system-ui, -apple-system, BlinkMacSystemFont, &#34;Segoe UI&#34;, sans-serif;&#xA;    }&#xA;&#xA;    .chart-card {&#xA;      width: min(100%, 960px);&#xA;      padding: clamp(18px, 4vw, 36px);&#xA;      border: 1px solid #e4e9f1;&#xA;      border-radius: 20px;&#xA;      background: var(--surface);&#xA;      box-shadow: 0 18px 55px rgb(15 23 42 / 8%);&#xA;    }&#xA;&#xA;    h1 { margin: 0; font-size: clamp(1.35rem, 3vw, 2rem); }&#xA;    .intro { margin: 6px 0 22px; color: var(--muted); }&#xA;&#xA;    .chart-wrap {&#xA;      position: relative;&#xA;      width: 100%;&#xA;      min-height: 420px;&#xA;    }&#xA;&#xA;    svg { display: block; width: 100%; height: auto; overflow: visible; }&#xA;    .grid-line { stroke: var(--grid); stroke-width: 1; }&#xA;    .axis-line { stroke: #98a2b3; stroke-width: 1.5; }&#xA;    .tick-label, .axis-label { fill: var(--muted); }&#xA;    .tick-label { font-size: 13px; }&#xA;    .axis-label { font-size: 14px; font-weight: 650; }&#xA;&#xA;    .exam-point {&#xA;      fill: var(--point);&#xA;      stroke: white;&#xA;      stroke-width: 3;&#xA;      cursor: pointer;&#xA;      opacity: 1;&#xA;      transform-box: fill-box;&#xA;      transform-origin: center;&#xA;      transition: opacity 160ms ease, transform 160ms ease, fill 160ms ease;&#xA;    }&#xA;&#xA;    .points.has-active .exam-point:not(.is-active) { opacity: .14; }&#xA;    .exam-point.is-active {&#xA;      fill: var(--point-active);&#xA;      transform: scale(1.45);&#xA;    }&#xA;    .exam-point:focus-visible { outline: 3px solid #fbbf24; outline-offset: 3px; }&#xA;&#xA;    .tooltip {&#xA;      position: absolute;&#xA;      z-index: 2;&#xA;      max-width: 260px;&#xA;      padding: 10px 12px;&#xA;      border-radius: 10px;&#xA;      color: white;&#xA;      background: #172033;&#xA;      box-shadow: 0 8px 24px rgb(15 23 42 / 25%);&#xA;      font-size: 14px;&#xA;      pointer-events: none;&#xA;      opacity: 0;&#xA;      transform: translate(-50%, calc(-100% - 15px));&#xA;      transition: opacity 120ms ease;&#xA;    }&#xA;    .tooltip.is-visible { opacity: 1; }&#xA;    .tooltip strong { display: block; margin-bottom: 2px; }&#xA;&#xA;    .hint { margin: 14px 0 0; color: var(--muted); font-size: 14px; }&#xA;  &lt;/style&gt;&#xA;&lt;/head&gt;&#xA;&lt;body&gt;&#xA;  &lt;main class=&#34;chart-card&#34;&gt;&#xA;    &lt;h1&gt;Risultati degli esami&lt;/h1&gt;&#xA;    &lt;p class=&#34;intro&#34;&gt;Passa il mouse su un punto per evidenziarlo; fai clic per aprire la traccia.&lt;/p&gt;</description>
